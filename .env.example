# PostgreSQL, FastAPI, worker and a separate migration step.
APP_ENV=development
PUBLIC_ORIGIN=http://127.0.0.1:8000
COOKIE_SECURE=false
POSTGRES_PASSWORD=admin
# Used outside Docker; Compose overrides the host with db.
DATABASE_URL=postgresql+psycopg://vector:${POSTGRES_PASSWORD}@127.0.0.1:5432/vector
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
SESSION_HOURS=12
AI_TIMEOUT_SECONDS=45
AI_MAX_COMPLETION_TOKENS=1800
AI_MAX_CONCURRENT_REQUESTS=4
REQUESTS_PER_MINUTE=10
REQUESTS_PER_DAY=200
LOGIN_ATTEMPTS_PER_MINUTE=20
MAX_PENDING_REQUESTS=100
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
CONTEXT_CHARACTER_BUDGET=24000
